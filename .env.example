# Copie para ".env" e ajuste os valores

# --- Broker MQTT ---
# EMQX Cloud Serverless (recomendado):  MQTT_HOST=xxxx.ala.us-east-1.emqxsl.com  MQTT_PORT=8883  MQTT_TLS=1
#   rede bloqueia a 8883? use  MQTT_PORT=8084  MQTT_TLS=1  MQTT_WEBSOCKET=1
# Broker local (broker_local.py): MQTT_HOST=localhost  MQTT_PORT=1883  MQTT_TLS=0  usuário/senha vazios
MQTT_HOST=xxxx.ala.us-east-1.emqxsl.com
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=
MQTT_TLS=1
MQTT_WEBSOCKET=0

# Porta do Arduino (veja na Arduino IDE em Ferramentas > Porta)
SERIAL_PORT=COM3
SERIAL_BAUD=9600

# Bot do Telegram (deixe vazio para desativar os alertas)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Segundos sem telemetria até considerar o dispositivo fora do ar
TIMEOUT_SEM_DADOS=60
